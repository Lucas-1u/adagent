# 复制本文件为 .env 并填入真实 key；.env 已被 .gitignore 忽略，不会提交到 git。
DEEPSEEK_API_KEY=sk-在此填入你的-key

# —— 可选配置（一般不用改）——
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# —— 客户发现（JustOneAPI）——
# token 到 https://justoneapi.com 控制台复制；余额不足时接口返回 upstream_business_code_601，
# 此时客户节点会立即断电（只花 1 次调用）并让报告进入"未交付"态。
JUSTONEAPI_TOKEN=在此填入你的-token

# —— 客户发现（数据源）——
# search（默认）：DeepSeek 官方 Search / Fetch，抓公开网页，只用 DEEPSEEK_API_KEY，约 0.01 元/轮
# justone       ：队友 1 的 JustOneAPI 采集链路，需要上面的 JUSTONEAPI_TOKEN 与余额
DISCOVERY_PROVIDER=search

# —— 客户发现调用预算 ——
# 演示口径：找到一家店就够，1 组关键词 × 1 个平台，拿到即收工 = 2 次接口调用。
DISCOVERY_PLAN_QUERIES=1
DISCOVERY_MAX_API_CALLS=3
DISCOVERY_MAX_TOOL_CALLS=6
DISCOVERY_SHOPS_PER_SEARCH=1
DISCOVERY_MERCHANTS_PER_SEARCH=1
DISCOVERY_PAGES=1
DISCOVERY_STOP_AFTER_FIRST=1
# 需要完整市场扫描时，把上面改成 PLAN_QUERIES=6 / MAX_API_CALLS=220 / 每组 5 家
